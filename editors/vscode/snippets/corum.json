{
    "Main Function": {
        "prefix": "main",
        "body": [
            "fun main(args: Array<String>) {",
            "\t$0",
            "}"
        ],
        "description": "Corum main function"
    },
    "Main Simple": {
        "prefix": "main0",
        "body": [
            "fun main() {",
            "\t$0",
            "}"
        ],
        "description": "Corum simple main function"
    },
    "Function": {
        "prefix": "fun",
        "body": [
            "fun ${1:name}(${2:params}): ${3:Void} {",
            "\t$0",
            "}"
        ],
        "description": "Function declaration"
    },
    "Operator Function": {
        "prefix": "opfun",
        "body": [
            "operator fun ${1:plus}(${2:other}: ${3:Type}): ${4:Type} {",
            "\t$0",
            "}"
        ],
        "description": "Operator function declaration"
    },
    "Inline Function": {
        "prefix": "infun",
        "body": [
            "inline fun ${1:name}(${2:params}): ${3:Type} {",
            "\t$0",
            "}"
        ],
        "description": "Inline function declaration"
    },
    "Const Function": {
        "prefix": "cfun",
        "body": [
            "const fun ${1:name}(${2:params}): ${3:Type} {",
            "\t$0",
            "}"
        ],
        "description": "Const function for compile-time execution"
    },
    "Val Variable": {
        "prefix": "val",
        "body": [
            "val ${1:name}: ${2:Int32} = ${3:value}"
        ],
        "description": "Immutable variable"
    },
    "Var Variable": {
        "prefix": "var",
        "body": [
            "var ${1:name}: ${2:Int32} = ${3:value}"
