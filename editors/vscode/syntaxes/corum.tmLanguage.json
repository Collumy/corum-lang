{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Corum",
    "scopeName": "source.corum",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#keywords" },
        { "include": "#modifiers" },
        { "include": "#types" },
        { "include": "#constants" },
        { "include": "#numbers" },
        { "include": "#functions" },
        { "include": "#operators" },
        { "include": "#variables" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.corum",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.corum",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.interpolated.corum",
                    "begin": "s\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.corum",
                            "match": "\\\\."
                        },
                        {
                            "name": "variable.other.interpolated.corum",
                            "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
                        },
                        {
                            "name": "meta.embedded.expression.corum",
                            "begin": "\\$\\{",
                            "end": "\\}",
                            "patterns": [
                                { "include": "$self" }
                            ]
                        }
                    ]
                },
                {
                    "name": "string.quoted.double.corum",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.corum",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.character.corum",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.corum",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.corum",
                    "match": "\\b(if|else|while|for|in|return|defer|unsafe|when|match|break|continue|as)\\b"
                },
                {
                    "name": "keyword.declaration.corum",
                    "match": "\\b(fun|val|var|class|struct|interface|enum|object|module|import)\\b"
                }
            ]
        },
        "modifiers": {
            "patterns": [
                {
                    "name": "storage.modifier.corum",
                    "match": "\\b(public|private|internal|inline|const|operator|infix|extern|packed|open|override)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.primitive.corum",
                    "match": "\\b(Void|Bool|Size|Int8|Int16|Int32|Int64|UInt8|UInt16|UInt32|UInt64|Float32|Float64|Str|String|Span|Array)\\b"
                },
                {
                    "name": "entity.name.type.class.corum",
                    "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.boolean.corum",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "constant.language.null.corum",
                    "match": "\\b(null)\\b"
                },
                {
                    "name": "variable.language.this.corum",
                    "match": "\\b(this|self|super)\\b"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.corum",
                    "match": "\\b0[xX][0-9a-fA-F_]+\\b"
                },
                {
                    "name": "constant.numeric.binary.corum",
                    "match": "\\b0[bB][01_]+\\b"
                },
                {
                    "name": "constant.numeric.float.corum",
                    "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b"
                },
                {
                    "name": "constant.numeric.integer.corum",
                    "match": "\\b[0-9][0-9_]*\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "match": "\\b(fun)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
                    "captures": {
                        "1": { "name": "keyword.declaration.corum" },
                        "2": { "name": "entity.name.function.corum" }
                    }
                },
                {
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
                    "name": "entity.name.function.call.corum"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.corum",
                    "match": "(&mut|&|\\+|\\-|\\*|/|%|=|==|!=|<|<=|>|>=|\\!|\\?|\\$|\\.|\\:|->|\\.\\.)"
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "name": "variable.other.corum",
                    "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
                }
            ]
        }
    }
}
